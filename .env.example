# Copy to `.env` and fill in real values. `.env` is gitignored - never commit it.
#
# Where each file is read:
#   * docker-compose.yml  -> reads `.env` in the project root (build args for the
#                            frontend, runtime env for the backend).
#   * backend (uvicorn)   -> backend/main.py loads `.env` from the project root,
#                            then `backend/.env` (real environment variables win).
#   * Flutter (local dev) -> NOT read automatically. Pass the values with
#                            `--dart-define=NAME=value` (see README) or
#                            `--dart-define-from-file=env.json` (env.json is gitignored).

# --- Frontend (compile-time, baked into the public web bundle) ---------------

# Supabase project URL (Project Settings -> API). Required for sign-in and data.
SUPABASE_URL=https://your-project.supabase.co

# Supabase *anon* (public) key. Safe to ship in the client ONLY because Row Level
# Security is enabled (supabase/*.sql). Never put the service_role key here.
SUPABASE_ANON_KEY=your-anon-key

# Base URL of the FastAPI backend as seen from the user's BROWSER.
# Local: http://localhost:8002. If unset, the client falls back to http://localhost:8002.
DETECTION_API_BASE_URL=http://localhost:8002

# Google Maps JavaScript API key. This is public by nature: restrict it by HTTP
# referrer in Google Cloud Console.
GOOGLE_MAPS_API_KEY=your-google-maps-key

# --- Backend (runtime, server-side only) --------------------------------------

# OpenRouter key (https://openrouter.ai/keys) used by /api/ai/* for place scoring
# and review-impact analysis. Secret: stays on the server. docker-compose only tells
# the frontend *whether* it is set (a non-secret flag); the key itself is never
# passed to the frontend build.
OPENROUTER_API_KEY=your-openrouter-key

# OpenRouteService key (https://openrouteservice.org/dev/#/signup) used by
# /api/route/safe-route. (`ORS_API_KEY` is accepted as an alias by the backend.)
OPENROUTESERVICE_API_KEY=your-openrouteservice-key

# Comma-separated list of frontend origins allowed by the backend's CORS policy.
# Defaults to "*" (any origin) if unset - set it to your real frontend origin in production.
ALLOWED_ORIGINS=http://localhost:8080
