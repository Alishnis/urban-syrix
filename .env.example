# Copy to .env and fill in real values.
# Used by docker-compose.yml (build args for the frontend, runtime env for the backend)
# and by `flutter run --dart-define=...` for local development.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
DETECTION_API_BASE_URL=http://localhost:8002
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTESERVICE_API_KEY=your-openrouteservice-key
GOOGLE_MAPS_API_KEY=your-google-maps-key

# Comma-separated list of allowed frontend origins for the backend's CORS policy.
# Defaults to "*" if unset — set this to your real frontend origin in production.
ALLOWED_ORIGINS=http://localhost:8080
